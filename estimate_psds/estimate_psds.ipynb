   "source": [
    "# Get and plot the galactic binaries in the dataset:\n",
    "\n",
    "n_samples = len(A_ts)\n",
    "A_gb_all = np.zeros(n_samples)\n",
    "E_gb_all = np.zeros(n_samples)\n",
    "T_gb_all = np.zeros(n_samples)\n",
    "for gb in ['dgb','igb','vgb']:\n",
    "    print(f'Adding {gb}')\n",
    "    tdi_ts, tdi_descr = hdfio.load_array(\n",
    "        input_data,\n",
    "        name=f\"sky/{gb}/tdi\"\n",
    "    )\n",
    "    X_gb = tdi_ts['X']\n",
    "    Y_gb = tdi_ts['Y']\n",
    "    Z_gb = tdi_ts['Z']\n",
    "\n",
    "    # Convert to AET timeseries\n",
    "    A_gb = (Z_gb - X_gb)/np.sqrt(2)\n",
    "    E_gb = (X_gb - 2*Y_gb + Z_gb)/np.sqrt(6)\n",
    "    T_gb = (X_gb + Y_gb + Z_gb)/np.sqrt(3)\n",
    "\n",
    "    A_gb_all += A_gb\n",
    "    E_gb_all += E_gb\n",
    "    T_gb_all += T_gb\n",
    "\n",
    "A_gb_ts = TimeSeries(A_gb_all, delta_t=5.)\n",
    "E_gb_ts = TimeSeries(E_gb_all, delta_t=5.)\n",
    "T_gb_ts = TimeSeries(T_gb_all, delta_t=5.)\n",
    "\n",
    "A_gb_psd = A_gb_ts.psd(segment_duration)\n",
    "E_gb_psd = E_gb_ts.psd(segment_duration)\n",
    "T_gb_psd = T_gb_ts.psd(segment_duration)\n",
    "\n",
    "A_gb_psd = interpolate(A_gb_psd, A_gb_ts.delta_f)\n",
    "E_gb_psd = interpolate(E_gb_psd, E_gb_ts.delta_f)\n",
    "T_gb_psd = interpolate(T_gb_psd, T_gb_ts.delta_f)\n",
    "\n",
    "print(\"Subtracting\")\n",
    "A_gb_residual_ts = A_ts - A_gb_ts\n",
    "E_gb_residual_ts = E_ts - E_gb_ts\n",
    "T_gb_residual_ts = T_ts - T_gb_ts\n",
    "\n",
    "A_gb_residual_psd = A_gb_residual_ts.psd(segment_duration)\n",
    "E_gb_residual_psd = E_gb_residual_ts.psd(segment_duration)\n",
    "T_gb_residual_psd = T_gb_residual_ts.psd(segment_duration)\n",
    "\n",
    "A_gb_residual_psd = interpolate(A_gb_residual_psd, A_gb_residual_ts.delta_f)\n",
    "E_gb_residual_psd = interpolate(E_gb_residual_psd, E_gb_residual_ts.delta_f)\n",
    "T_gb_residual_psd = interpolate(T_gb_residual_psd, T_gb_residual_ts.delta_f)"
   ]
